{
  "realm": "jupiter",
  "enabled": true,
  "displayName": "Jupiter Cars",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      { "name": "SUPER_ADMIN", "description": "Full platform administration" },
      { "name": "ADMIN", "description": "Platform administration" },
      { "name": "CONTENT_MANAGER", "description": "Vehicle and media publishing" },
      { "name": "SALES_MANAGER", "description": "Vehicle sales and leads" },
      { "name": "RENTAL_MANAGER", "description": "Hire fleet and bookings" },
      { "name": "SUPPORT", "description": "Customer support and enquiries" },
      { "name": "admin", "description": "Jupiter Cars administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "jupiter-web",
      "name": "Jupiter Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8081/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost:8081", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8081/* http://localhost:5173/*"
      }
    }
  ]
}